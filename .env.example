# Neon PostgreSQL Connection URLs
# DATABASE_URL: Pooled URL for Next.js app queries (hostname contains -pooler)
DATABASE_URL="postgresql://user:password@ep-something-pooler.region.aws.neon.tech/neondb?sslmode=require"

# DATABASE_URL_UNPOOLED: Direct URL for Drizzle Kit migrations (hostname without -pooler)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-something.region.aws.neon.tech/neondb?sslmode=require"
